pkgname = linux-ttm-test
	pkgdesc = The Linux with the drm/TTM swapout bulk_move fix (drm/amd#5387) kernel and modules
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-ttm-test-headers: headers and scripts for building modules
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux-ttm-test-headers
	pkgdesc = Headers and scripts for building modules for the Linux with the drm/TTM swapout bulk_move fix (drm/amd#5387) kernel
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS

pkgname = linux-ttm-test-docs
	pkgdesc = Documentation for the Linux with the drm/TTM swapout bulk_move fix (drm/amd#5387) kernel
